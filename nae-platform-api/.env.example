DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nae
DB_USER=nae
DB_PASSWORD=change-me
API_TOKEN=change-me
ANALYTICS_USERNAME=admin
ANALYTICS_PASSWORD=change-me
# Opcional: cuentas adicionales separadas por punto y coma.
# Formato: usuario1:password1;usuario2:password2
ANALYTICS_USERS=
# Opcional: usuarios que pueden acceder a Revisión. ANALYTICS_USERNAME siempre tiene permiso.
# Formatos válidos: usuario1;usuario2 o usuario1:password1;usuario2:password2
ANALYTICS_REVIEW_USERS=
SESSION_SECRET=change-me
# 8 horas por defecto.
SESSION_MAX_AGE_SECONDS=28800
# En producción con HTTPS externo, puede ponerse en true si el navegador entra por HTTPS.
SESSION_COOKIE_SECURE=false


